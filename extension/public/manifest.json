{
  "manifest_version": 3,
  "name": "Celari Wallet",
  "version": "0.5.0",
  "minimum_chrome_version": "116",
  "description": "Privacy-first super wallet for Aztec Network. Passkey authentication, private transfers, crypto card spending.",
  "homepage_url": "https://github.com/Kubudak90/celari-wallet",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    },
    "default_title": "Celari Wallet"
  },
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/content.js"],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "activeTab",
    "notifications",
    "alarms",
    "offscreen",
    "sidePanel"
  ],
  "side_panel": {
    "default_path": "popup.html?panel=1"
  },
  "host_permissions": [
    "https://*.aztec-labs.com/*",
    "https://*.aztec.network/*",
    "https://aztec-faucet.nethermind.io/*",
    "https://aztec-faucet.dev-nethermind.xyz/*",
    "wss://relay.walletconnect.com/*",
    "wss://relay.walletconnect.org/*"
  ],
  "optional_host_permissions": [
    "http://localhost:8080/*",
    "http://localhost:3456/*",
    "http://139.99.149.238:3456/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["src/inpage.js", "wasm/*"],
      "matches": ["<all_urls>"]
    }
  ],
  "cross_origin_opener_policy": { "value": "same-origin" },
  "cross_origin_embedder_policy": { "value": "require-corp" },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
